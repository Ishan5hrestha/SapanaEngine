struct PSInput
{
    float4 Pos      : SV_POSITION;
    float4 Color    : COLOR0;
    float3 WorldPos : COLOR1;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

#if ENABLE_BASIC_SHADOWS
cbuffer Constants
{
    float4x4 g_WorldViewProj;
    float4x4 g_World;
    float4x4 g_WorldToLightProj;
    float4   g_ColorTint;
};

Texture2DArray<float>  g_ShadowMap;
SamplerComparisonState g_ShadowMap_sampler;

float SampleShadowPCF(float2 uv, float depth)
{
    float w = 0.0;
    float h = 0.0;
    float elems = 0.0;
    g_ShadowMap.GetDimensions(w, h, elems);
    float2 texel = float2(1.0 / max(w, 1.0), 1.0 / max(h, 1.0));

    // 5x5 PCF (25 taps); each SampleCmp also does hardware 2x2 filtering.
    float sum = 0.0;
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            float2 offset = float2(x, y) * texel;
            sum += g_ShadowMap.SampleCmp(g_ShadowMap_sampler, float3(uv + offset, 0.0), depth);
        }
    }
    return sum / 25.0;
}
#endif

void main(in  PSInput  PSIn,
          out PSOutput PSOut)
{
    float4 Color = PSIn.Color;
#if ENABLE_BASIC_SHADOWS
    float4 ShadowPos = mul(float4(PSIn.WorldPos, 1.0), g_WorldToLightProj);
    ShadowPos.xyz /= max(ShadowPos.w, 1e-6);
    float2 ShadowUV = NormalizedDeviceXYToTexUV(ShadowPos.xy);
    float  ShadowZ  = NormalizedDeviceZToDepth(ShadowPos.z);
    float  Shadowing = 1.0;
    if (ShadowUV.x > 0.001 && ShadowUV.x < 0.999 && ShadowUV.y > 0.001 && ShadowUV.y < 0.999)
        Shadowing = SampleShadowPCF(ShadowUV, max(ShadowZ - 0.0015, 1e-7));
    // Soft ambient so shadowed regions stay readable.
    Color.rgb *= (0.28 + 0.72 * Shadowing);
#endif
#if CONVERT_PS_OUTPUT_TO_GAMMA
    // Use fast approximation for gamma correction.
    Color.rgb = pow(Color.rgb, float3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
#endif
    PSOut.Color = Color;
}
